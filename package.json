{
  "name": "helpr",
  "productName": "helpr",
  "version": "0.1.0",
  "private": true,
  "description": "本机真实网页任务工作区",
  "author": "helpr",
  "license": "UNLICENSED",
  "main": "dist/main/main.cjs",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "dev": "node scripts/build-native.mjs && electron-vite dev",
    "compile": "node scripts/build-native.mjs && electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app tests/workspace electron.vite.config.ts drizzle.config.ts vitest.config.ts",
    "format": "prettier --write app tests/workspace *.ts *.json *.mjs pnpm-workspace.yaml",
    "format:check": "prettier --check app tests/workspace *.ts *.json *.mjs pnpm-workspace.yaml",
    "test:workspace": "vitest run",
    "check:legacy": "node scripts/check.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:workspace && pnpm check:legacy",
    "build:mac": "node scripts/build-mac.mjs",
    "validate:workspace": "node scripts/validate-workspace.mjs",
    "test:browser": "npm --prefix .scratch/helpr-first-release/experiments/runtime-flow-replay test && node --test .scratch/helpr-first-release/experiments/result-recovery/proxy.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.69",
    "ai": "7.0.141",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "pino": "10.4.0",
    "pino-roll": "4.0.0",
    "playwright-core": "1.64.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.0",
    "react-dom": "19.3.0",
    "xstate": "5.33.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.11",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
